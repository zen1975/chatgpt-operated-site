{
  "name": "sitewright",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "test": "npm run test:contract",
    "test:contract": "node --test \"tests/**/*.test.mjs\"",
    "test:migrations:base": "node scripts/check-migration-immutability.mjs",
    "verify": "npm run build && npm run test:contract",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "migrations:checksums": "node scripts/migration-checksums.mjs",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.1.3",
    "astro": "6.0.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.0",
    "esbuild": "0.27.7",
    "playwright": "1.55.0",
    "typescript": "5.9.3",
    "wrangler": "4.61.1"
  },
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
