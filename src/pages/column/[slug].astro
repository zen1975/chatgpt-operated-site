---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleRenderer from '@/components/ArticleRenderer.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import TimedContentSlot from '@/components/TimedContentSlot.astro';
import { getArticleBySlugWithMedia } from '@/lib/content';
import type { ContentBlockType } from '@/server/core/content-ast';

const { slug } = Astro.params;
const item = slug ? await getArticleBySlugWithMedia(slug) : null;
if (!item) return new Response(null, { status: 404 });

const blocks = JSON.parse(item.blocks_json) as ContentBlockType[];
const title = `${item.seo_title || item.title} | Example Company`;
const description = item.seo_description || item.excerpt || '';
---
<BaseLayout title={title} description={description} ogType="article" ogImage={item.media.ogp?.path}>
  <main>
    <article class="section"><div class="shell prose">
      <p class="eyebrow">Insights</p>
      <h1>{item.title}</h1>
      {item.published_at && <p><small>{item.published_at.slice(0,10)}</small></p>}
      {item.media.hero && <img src={item.media.hero.path} alt="" />}
      <ArticleRenderer blocks={blocks} />
      <ShareButtons title={item.title} url={Astro.url.toString()} />
    </div></article>
    <TimedContentSlot placement="article_bottom" />
  </main>
</BaseLayout>
