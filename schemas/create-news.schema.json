{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["title","blocks"],
  "properties":{
    "title":{"type":"string","minLength":1,"maxLength":80},
    "slug":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "excerpt":{"type":["string","null"],"maxLength":160},
    "blocks":{"type":"array","minItems":1},
    "contentType":{"enum":["news","article"]},
    "templateProfile":{"type":"string","maxLength":80},
    "categoryTermIds":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "tagTermIds":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "publishedAt":{"type":["string","null"],"format":"date-time"},
    "startsAt":{"type":["string","null"],"format":"date-time"},
    "endsAt":{"type":["string","null"],"format":"date-time"},
    "seoTitle":{"type":["string","null"],"maxLength":60},
    "seoDescription":{"type":["string","null"],"maxLength":160},
    "expectedVersion":{"type":["integer","null"],"minimum":1}
  }
}
